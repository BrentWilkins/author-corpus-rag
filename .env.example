# Keep private corpus details in the ignored YAML file referenced here.
AUTHOR_CORPUS_CONFIG=/absolute/path/to/corpus.local.yaml
AUTHOR_CORPUS_RETRIEVAL_EVAL=/absolute/path/to/retrieval-eval.local.yaml
# Optional private claim/evidence labels; defaults to the committed synthetic
# benchmark in the notebook. Provenance-bearing cases also populate the local
# Gradio claim-review tab.
# AUTHOR_CORPUS_CLAIM_EVAL=/absolute/path/to/claim-classification.local.yaml
# Optional private labels tied to generated trace/candidate/evidence IDs.
# AUTHOR_CORPUS_GENERATED_CLAIM_EVAL=/absolute/path/to/generated-claims.local.yaml
# Optional private aggregate labels for comparing claim verifiers. Keep
# development and unseen holdout query/source groups in separate files.
# AUTHOR_CORPUS_VERIFIER_EVAL=/absolute/path/to/verifier-eval.local.yaml

# Optional private focal author used to resolve phrases such as "the author".
# Exact names in questions always take precedence; unknown names never fall
# back to this value.
AUTHOR_CORPUS_DEFAULT_AUTHOR=Example Author
# Optional trusted nicknames or pen names for the default author. This must be
# a JSON array; the system never guesses fuzzy nickname relationships.
AUTHOR_CORPUS_DEFAULT_AUTHOR_ALIASES=["Example", "E. Author"]

# Optional local-model settings used by the notebook and future chat app.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=your-local-chat-model
OLLAMA_REASONING_EFFORT=none
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Expensive notebook operations are opt-in. Loading an existing index and
# inspecting semantic evidence remain available with both values unset.
# AUTHOR_CORPUS_ALLOW_INDEX_BUILD=1
# AUTHOR_CORPUS_RUN_GROUNDED_ANSWER=1
